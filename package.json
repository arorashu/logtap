{
  "name": "@arorashu/logtap",
  "version": "0.1.0",
  "description": "Minimal client-side logging harness for web development",
  "type": "module",
  "license": "MIT",
  "author": "arorashu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arorashu/logtap.git"
  },
  "bugs": {
    "url": "https://github.com/arorashu/logtap/issues"
  },
  "homepage": "https://github.com/arorashu/logtap#readme",
  "keywords": [
    "logging",
    "browser",
    "frontend",
    "debugging",
    "agents",
    "observability",
    "jsonl"
  ],
  "packageManager": "bun@1.3.13",
  "main": "./dist/server/index.js",
  "types": "./dist/types/src/server/index.d.ts",
  "bin": {
    "logtap": "./dist/bin/logtap.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./browser": {
      "types": "./dist/types/src/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./server": {
      "types": "./dist/types/src/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "examples",
    "docs",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run bin/logtap.ts start",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/browser/index.ts --outdir dist/browser --target browser --format esm && bun build src/server/index.ts --outdir dist/server --target node --format esm && bun build bin/logtap.ts --outfile dist/bin/logtap.js --target bun",
    "build:types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run build",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^2.0.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "optionalDependencies": {
    "@jridgewell/trace-mapping": "^0.3.25"
  }
}
